# Application Settings
PROJECT_NAME="Smart SOS Roadside Emergency Response System"
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://sos_user:sos_password@localhost:5432/sos_db
SQLITE_FALLBACK_URL=sqlite:///./sos_app.db

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_KEEPALIVE=60
MQTT_USERNAME=
MQTT_PASSWORD=

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=10

# Digital Twin Simulation Config
HEARTBEAT_INTERVAL_SECONDS=5
TELEMETRY_INTERVAL_SECONDS=3
